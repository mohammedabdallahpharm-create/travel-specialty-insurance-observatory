{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/signal.schema.json",
  "title": "Observatory Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id", "title", "domain", "market", "signal_type",
    "publication_date", "observation_date", "primary_sources",
    "evidence_summary", "verified_facts", "unestablished_claims",
    "competing_hypotheses", "confidence_level", "evidence_gaps",
    "next_research_question", "research_decision", "record_status"
  ],
  "properties": {
    "signal_id": {"type": "string", "pattern": "^SIGNAL-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"enum": ["TRAVEL", "PET"]},
    "subdomain": {"type": ["string", "null"]},
    "market": {"type": "string", "minLength": 1},
    "signal_type": {"type": "string", "minLength": 1},
    "event_date": {"type": ["string", "null"], "format": "date"},
    "publication_date": {"type": "string", "format": "date"},
    "observation_date": {"type": "string", "format": "date"},
    "organisations": {"type": "array", "items": {"type": "string"}},
    "entity_roles": {"type": "array", "items": {"type": "object", "required": ["entity_id", "role"], "properties": {"entity_id": {"type": "string"}, "role": {"type": "string"}}, "additionalProperties": false}},
    "primary_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "publisher", "url"], "properties": {"title": {"type": "string"}, "publisher": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "publication_date": {"type": ["string", "null"], "format": "date"}, "accessed_date": {"type": ["string", "null"], "format": "date"}, "notes": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "evidence_summary": {"type": "string"},
    "verified_facts": {"type": "array", "items": {"type": "string"}},
    "unestablished_claims": {"type": "array", "items": {"type": "string"}},
    "competing_hypotheses": {"type": "array", "items": {"type": "string"}},
    "operational_implications": {"type": "array", "items": {"type": "string"}},
    "commercial_implications": {"type": "array", "items": {"type": "string"}},
    "workforce_implications": {"type": "array", "items": {"type": "string"}},
    "technology_implications": {"type": "array", "items": {"type": "string"}},
    "confidence_level": {"enum": ["Low", "Medium", "High"]},
    "evidence_status": {"enum": ["Verified", "Partially Verified", "Unverified", "Hypothesis", "Disputed", "Historical"]},
    "follow_up_indicators": {"type": "array", "items": {"type": "string"}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "next_research_question": {"type": "string"},
    "research_decision": {"enum": ["Publish", "Continue Research", "Monitor", "Reject", "Archive"]},
    "record_status": {"enum": ["draft", "under_review", "published", "archived"]}
  }
}